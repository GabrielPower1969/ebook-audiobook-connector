# copy to .env to override — all optional
AC_PORT=8765
# Linux only: make container-written files owned by you (macOS ignores this)
#AC_UID=1000
#AC_GID=1000

# --- Public access through Cloudflare (docker compose --profile public up -d) ---
# Zero Trust → Networks → Tunnels → your tunnel → token
#TUNNEL_TOKEN=eyJ...
# Zero Trust team name, e.g. "flowgt" for https://flowgt.cloudflareaccess.com
#AC_ACCESS_TEAM=flowgt
# Zero Trust → Access → Applications → your app → Overview → Application Audience (AUD) Tag
#AC_ACCESS_AUD=0123456789abcdef...
# Set to 1 to require login on the LAN too (default: LAN readers are anonymous "local")
#AC_REQUIRE_AUTH=
